# Copy this file to server/.env and fill it in. server/.env is git-ignored: never commit it.

PORT=8787
# Where the website runs. Comma-separate several (local + your real domain).
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- MongoDB Atlas ---
# Atlas > Connect > Drivers > copy the connection string and put your DB user's password in it.
MONGODB_URI=
MONGODB_DB=portfolio
MONGODB_COLLECTION=contacts

# --- Email (SMTP) ---
# Gmail: turn on 2-step verification, then create an App Password (Google Account > Security > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Where the messages are delivered, and the From address (Gmail only allows your own address).
MAIL_TO=
MAIL_FROM=

# Behind a proxy or host (Render, Railway, Nginx)? Set to the number of proxies so rate limiting sees real IPs.
# TRUST_PROXY=1
